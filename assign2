#include <xc.h>

// Configuration bits
#pragma config OSC = HS
#pragma config WDT = OFF
#pragma config LVP = OFF
#pragma config PBADEN = OFF

void main(void)
{
    unsigned int count = 0;
    unsigned int i = 0;
    unsigned int wait = 0;

    unsigned char flag = 0;

    // LEDs
    TRISB = 0x00;
    PORTB = 0x00;

    // Switches
    TRISC = 0xFF;

    while(1)
    {
        // -------- Switch Selection --------
        if(PORTCbits.RC0 == 0)
        {
            flag = 1;
            count = 0;
            PORTB = 0x00;
        }
        else if(PORTCbits.RC1 == 0)
        {
            flag = 2;
            count = 0;
            PORTB = 0x00;
        }
        else if(PORTCbits.RC2 == 0)
        {
            flag = 3;
            wait = 0;
        }
        else if(PORTCbits.RC3 == 0)
        {
            flag = 4;
            wait = 0;
        }


        // -------- Pattern 1 --------
        // ON L?R, OFF L?R, ON R?L, OFF R?L
        if(flag == 1)
        {
            if(wait++ == 25000)
            {
                i = count % 8;

                if(count < 8)
                    PORTB |= (1 << i);

                else if(count < 16)
                    PORTB &= ~(1 << i);

                else if(count < 24)
                    PORTB |= (1 << (7 - i));

                else if(count < 32)
                    PORTB &= ~(1 << (7 - i));

                else
                {
                    count = 0;
                    wait = 0;
                    continue;
                }

                count++;
                wait = 0;
            }
        }


        // -------- Pattern 2 --------
        // ON L?R then OFF L?R
        else if(flag == 2)
        {
            if(wait++ == 25000)
            {
                i = count % 8;

                if(count < 8)
                    PORTB |= (1 << i);

                else if(count < 16)
                    PORTB &= ~(1 << i);

                else
                {
                    count = 0;
                    wait = 0;
                    continue;
                }

                count++;
                wait = 0;
            }
        }


        // -------- Pattern 3 --------
        // Alternate LEDs
        else if(flag == 3)
        {
            if(wait++ <= 25000)
                PORTB = 0x55;

            else if(wait <= 50000)
                PORTB = 0xAA;

            else
                wait = 0;
        }


        // -------- Pattern 4 --------
        // Nibble blinking
        else if(flag == 4)
        {
            if(wait++ <= 25000)
                PORTB = 0xF0;

            else if(wait <= 50000)
                PORTB = 0x0F;

            else
                wait = 0;
        }


        // -------- Default --------
        else
        {
            PORTB = 0x00;
        }
    }
}
