#include <xc.h>

void delay() {
    for(unsigned long i = 0; i < 50000; i++);
}

void pattern1() {
    for(int i = 0; i < 8; i++)
    {
        PORTB = (1 << i);
        delay();
    }

    for(int i = 6; i >= 1; i--)
    {
        PORTB = (1 << i);
        delay();
    }
}

void pattern2() {
    for(int i = 0; i < 8; i++)
    {
        PORTB |= (1 << i);
        delay();
    }

    for(int i = 0; i < 8; i++)
    {
        PORTB &= ~(1 << i);
        delay();
    }
}

void pattern3() {
    PORTB = 0xAA;   // 10101010
    delay();

    PORTB = 0x55;   // 01010101
    delay();
}

void pattern4() {
    PORTB = 0xF0;   // First 4 OFF, next 4 ON
    delay();

    PORTB = 0x0F;   // First 4 ON, next 4 OFF
    delay();
}

void main() {
    TRISB = 0x00;   // LEDs as output
    TRISD = 0x0F;   // Sw
    {
        TRISB = 0x00;   // LEDs as output
        TRISD = 0x0F;   // Switches as input

        PORTB = 0x00;   // All LEDs OFF

        while(1)
        {
            if(RC0 == 0)        // Switch 1
            {
                pattern1();
            }
            else if(RC1 == 0)   // Switch 2
            {
                pattern2();
            }
            else if(RC2 == 0)   // Switch 3
            {
                pattern3();
            }
            else if(RC3 == 0)   // Switch 4
            {
                pattern4();
            }
        }
    }

